<%= form_with(model: provider_credential, local: true) do |form| %>
  <% if provider_credential.errors.any? %>
    <div class="ck-flash ck-flash--alert" role="alert">
      <p class="ck-flash__title"><%= pluralize(provider_credential.errors.count, "problem") %> prevented this provider credential from being saved.</p>
      <ul class="ck-error-list">
        <% provider_credential.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="ck-card ck-form-card">
    <div class="ck-field">
      <%= form.label :provider, class: "ck-label" %>
      <%= form.select :provider, CompletionKit::ProviderCredential::PROVIDERS.map { |p| [CompletionKit::ProviderCredential::PROVIDER_LABELS[p] || p.titleize, p] }, {}, { class: "ck-input" } %>
    </div>

    <div class="ck-field">
      <%= form.label :api_key, "API key", class: "ck-label" %>
      <%= form.text_area :api_key, rows: 3, class: "ck-input ck-input--area ck-input--code", placeholder: "Paste the provider API key", **ck_field_aria(form, :api_key) %>
      <%= ck_field_error(form, :api_key) %>
    </div>

    <div class="ck-field">
      <%= form.label :api_endpoint, "API endpoint", class: "ck-label" %>
      <%= form.text_field :api_endpoint, class: "ck-input", placeholder: "Only needed for Ollama or custom OpenAI-compatible endpoints", **ck_field_aria(form, :api_endpoint) %>
      <%= ck_field_error(form, :api_endpoint) %>
    </div>

    <% if provider_credential.persisted? && provider_credential.in_use? %>
      <p class="ck-field-hint"><%= provider_credential.in_use_message %></p>
    <% end %>

    <div class="ck-actions">
      <% if provider_credential.persisted? && !provider_credential.in_use? %>
        <%= button_to provider_credential_path(provider_credential), method: :delete,
              form_class: "inline-block",
              class: "ck-icon-btn",
              title: "Delete provider",
              "aria-label": "Delete provider",
              data: { turbo_confirm: "Delete the #{provider_credential.display_provider} provider and its discovered models? This can't be undone." } do %>
          <%= heroicon_tag "trash", variant: :outline, size: 16, "aria-hidden": "true" %>
        <% end %>
      <% end %>
      <%= link_to "Cancel", provider_credentials_path, class: ck_button_classes(:light, variant: :outline), tabindex: "0" %>
      <%= form.submit(provider_credential.persisted? ? "Save provider" : "Create provider", class: ck_button_classes(:dark)) %>
    </div>

  </div>
<% end %>

<% if provider_credential.persisted? %>
  <%= turbo_stream_from "completion_kit_provider_#{provider_credential.id}" %>
  <div data-ck-statuses-url="<%= statuses_provider_credentials_path %>">
    <%= render "models_card", provider_credential: provider_credential %>
  </div>
<% end %>
