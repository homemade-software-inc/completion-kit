<% if provider_credential.persisted? %>
  <% pc_delete_id = "ck_delete_provider_#{provider_credential.id}" %>
  <% pc_delete_confirm = "Delete the #{provider_credential.display_provider} provider and its discovered models? This can't be undone." %>
<% end %>
<%= form_with(model: provider_credential, local: true) do |form| %>
  <% if provider_credential.errors.any? %>
    <div class="ck-flash ck-flash--alert" role="alert">
      <p class="ck-flash__title"><%= pluralize(provider_credential.errors.count, "problem") %> prevented this provider credential from being saved.</p>
      <ul class="ck-error-list">
        <% provider_credential.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="ck-card ck-form-card">
    <div class="ck-field">
      <%= form.label :provider, class: "ck-label" %>
      <%= form.select :provider, CompletionKit::ProviderCredential::PROVIDERS.map { |p| [CompletionKit::ProviderCredential::PROVIDER_LABELS[p] || p.titleize, p] }, {}, { class: "ck-input", data: { ck_provider_select: true } } %>
    </div>

    <div class="ck-field">
      <%= form.label :api_key, "API key", class: "ck-label" %>
      <%= form.text_area :api_key, value: (provider_credential.persisted? ? "" : provider_credential.api_key), rows: 3, class: "ck-input ck-input--area ck-input--code", placeholder: "Paste the provider API key", **ck_field_aria(form, :api_key) %>
      <%= ck_field_error(form, :api_key) %>
      <% if provider_credential.api_key_stored? %>
        <p class="ck-field-hint">
          <% if provider_credential.api_key_ending %>
            Leave blank to keep the current key ending in <code><%= provider_credential.api_key_ending %></code>.
          <% else %>
            Leave blank to keep the current key.
          <% end %>
          Enter it again if you change the provider or endpoint.
        </p>
      <% end %>
    </div>

    <% if provider_credential.api_key_stored? %>
      <div class="ck-field">
        <label class="ck-checkbox-label">
          <%= check_box_tag "provider_credential[remove_api_key]", "1", local_assigns[:remove_api_key], id: "provider_credential_remove_api_key", class: "ck-checkbox" %>
          <span class="ck-checkbox-label__box" aria-hidden="true"></span>
          <span class="ck-checkbox-label__body">
            <span class="ck-checkbox-label__text">Remove the stored key</span>
            <span class="ck-checkbox-label__hint">For endpoints that run without a key, such as a local Ollama server.</span>
          </span>
        </label>
      </div>
    <% end %>

    <div class="ck-field">
      <%= form.label :api_endpoint, "API endpoint", class: "ck-label" %>
      <%= form.text_field :api_endpoint, class: "ck-input", placeholder: "Needed for Ollama, Azure AI Foundry, or custom OpenAI-compatible endpoints", **ck_field_aria(form, :api_endpoint) %>
      <%= ck_field_error(form, :api_endpoint) %>
    </div>

    <div class="ck-field" data-ck-provider-field="azure_foundry"<%= provider_credential.azure_foundry? ? "" : " hidden" %>>
      <%= form.label :api_version, "API version", class: "ck-label" %>
      <%= form.text_field :api_version, class: "ck-input", placeholder: "e.g. 2024-10-21", **ck_field_aria(form, :api_version) %>
      <%= ck_field_error(form, :api_version) %>
      <p class="ck-field-hint">Optional. Leave blank to use Azure's v1 API.</p>
    </div>

    <div class="ck-actions">
      <% if provider_credential.persisted? %>
        <%= ck_delete_trigger(form_id: pc_delete_id, label: "Delete provider", confirm: pc_delete_confirm) %>
      <% end %>
      <%= link_to "Cancel", provider_credentials_path, class: ck_button_classes(:light, variant: :outline), tabindex: "0" %>
      <%= form.submit(provider_credential.persisted? ? "Save provider" : "Create provider", class: ck_button_classes(:dark)) %>
    </div>

  </div>
<% end %>

<% if provider_credential.persisted? %>
  <%= render "completion_kit/shared/delete_form", form_id: pc_delete_id, path: provider_credential_path(provider_credential) %>
<% end %>

<% if provider_credential.persisted? %>
  <%= turbo_stream_from "completion_kit_provider_#{provider_credential.id}" %>
  <div data-ck-statuses-url="<%= statuses_provider_credentials_path %>">
    <%= render "models_card", provider_credential: provider_credential %>
  </div>
<% end %>
