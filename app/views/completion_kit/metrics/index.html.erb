<section class="ck-page-header">
  <div>
    <h1 class="ck-title">Metrics</h1>
    <p class="ck-lead">Scoring dimensions used to evaluate each response. Each defines one thing to assess, by an LLM judge on a 1-5 scale or a deterministic check.</p>
  </div>
  <div class="ck-actions">
    <%= link_to "Import from Promptfoo", import_path, class: ck_button_classes(:light, variant: :outline) %>
    <%= link_to "New metric", new_metric_path, class: ck_button_classes(:dark) %>
  </div>
</section>

<%= render "completion_kit/tags/filter_bar",
      available: @available_tags,
      selected: @selected_tags,
      base_path: metrics_path %>

<% if @metrics.any? %>
  <table class="ck-results-table ck-metrics-table">
    <thead>
      <tr>
        <th scope="col">Name</th>
        <th scope="col">Version</th>
        <th scope="col">Instruction</th>
        <th scope="col">In groups</th>
        <th scope="col"></th>
      </tr>
    </thead>
    <tbody>
      <% @metrics.each do |metric| %>
        <tr onclick="window.location='<%= metric_path(metric) %>'" style="cursor: pointer;">
          <td>
            <%= link_to metric_path(metric), class: "ck-record-name" do %><strong><%= metric.name %></strong><% end %>
            <span class="ck-chip ck-chip--soft ck-metric-type-chip"><%= metric.check? ? "Check" : "Judge" %></span>
            <% if metric.tags.any? %>
              <div class="tag-marks-row">
                <%= render "completion_kit/tags/marks", tags: metric.tags %>
              </div>
            <% end %>
          </td>
          <td data-label="Version">
            <% v = @current_versions[metric.id] %>
            <span class="ck-chip ck-chip--soft"><%= v ? v.version_label : "v1" %></span>
          </td>
          <td data-label="Instruction" class="ck-meta-copy"><div class="ck-clamp-2"><%= metric.instruction.presence || "—" %></div></td>
          <td data-label="In groups">
            <% groups = metric.metric_groups %>
            <% if groups.any? %>
              <div class="ck-metrics-table__groups">
                <% groups.each do |g| %>
                  <%= link_to metric_group_path(g), class: "ck-metric-group-pill ck-metric-group-pill--active", onclick: "event.stopPropagation();" do %>
                    <span class="ck-metric-group-pill__label"><%= g.name %></span>
                  <% end %>
                <% end %>
              </div>
            <% else %>
              <span class="ck-metrics-table__dim">—</span>
            <% end %>
          </td>
          <td class="ck-results-table__arrow">&rarr;</td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if @metrics.size >= 2 %>
    <p class="ck-meta-copy" style="margin-top: 1.5rem; text-align: center;">
      Use the same metrics on multiple runs? <%= link_to "Group them →", metric_groups_path, class: "ck-link" %>
    </p>
  <% end %>

  <% if @available_starters.any? %>
    <section class="ck-starter-row">
      <p class="ck-kicker">Skip the blank page</p>
      <p class="ck-meta-copy">Pre-written metrics for the dimensions most teams score against, both LLM judges and deterministic checks. Click a card to preview before it's created.</p>
      <div class="ck-starter-grid">
        <% @available_starters.each do |starter| %>
          <%= render "starter_card", starter: starter %>
        <% end %>
      </div>
    </section>
  <% end %>
<% elsif @selected_tags.any? %>
  <div class="ck-empty">
    <p>No metrics match these tags. <%= link_to "Clear filters", metrics_path, class: "ck-link" %>.</p>
  </div>
<% else %>
  <% if @available_starters.any? %>
    <section class="ck-starter-row ck-starter-row--empty-state">
      <h2 class="ck-title ck-title--sm">Skip the blank page</h2>
      <p class="ck-lead">Starter metrics we've worked through for common evaluation dimensions, both LLM judges and deterministic checks. Adopt one to drop in a pre-written metric, edit anything after. Or <%= link_to "write your own from scratch", new_metric_path, class: "ck-link" %>.</p>
      <div class="ck-starter-grid">
        <% @available_starters.each do |starter| %>
          <%= render "starter_card", starter: starter %>
        <% end %>
      </div>
    </section>
  <% else %>
    <div class="ck-empty">
      <p>No metrics yet. <%= link_to "Create your first metric", new_metric_path, class: "ck-link" %> to start scoring prompt outputs.</p>
    </div>
  <% end %>
<% end %>
