<% suggestion = local_assigns[:suggestion_draft] %>
<% edit_draft = local_assigns[:edit_draft] %>
<% suggestion_bands = suggestion ? Array(suggestion.rubric_bands).each_with_object({}) { |b, h| h[b["stars"].to_i] = b["description"].to_s } : {} %>
<% suggested_instruction = suggestion&.instruction.to_s %>
<% instruction_changed = suggestion && suggested_instruction.present? && suggested_instruction != metric.instruction.to_s %>
<% if metric.persisted? %>
  <% metric_delete_id = "ck_delete_metric_#{metric.id}" %>
  <% groups_n = metric.metric_groups.count %>
  <% reviews_n = metric.reviews.count %>
  <% parts = [] %>
  <% parts << "in #{pluralize(groups_n, 'metric group')} (removed from each)" if groups_n > 0 %>
  <% parts << "scored in #{pluralize(reviews_n, 'review')} (scores kept, link cleared)" if reviews_n > 0 %>
  <% metric_delete_confirm = parts.empty? ? "Delete \"#{metric.name}\"? It's not in use." : "Delete \"#{metric.name}\"? It's #{parts.to_sentence}." %>
<% end %>

<% if edit_draft %>
  <% pub = local_assigns[:published_metric_version] %>
  <% draft_instr_changed = pub && pub.instruction.to_s != edit_draft.instruction.to_s %>
  <% draft_rubric_changed = pub && pub.rubric_bands != edit_draft.rubric_bands %>
  <div class="ck-suggestion-banner" role="status">
    <div class="ck-suggestion-banner__body">
      <p class="ck-kicker">Draft pending</p>
      <p class="ck-meta-copy">The form below shows your unpublished draft. Publish to replace the live<%= " instruction" if draft_instr_changed %><%= " and" if draft_instr_changed && draft_rubric_changed %><%= " rubric" if draft_rubric_changed %> for future runs, or keep editing.</p>
    </div>
    <div class="ck-suggestion-banner__actions">
      <%= button_to "Discard draft", dismiss_suggestion_metric_path(metric, draft_id: edit_draft.id, back_to: "edit"),
            method: :delete, form_class: "inline-block",
            class: ck_button_classes(:light, variant: :outline),
            data: { turbo_confirm: "Drop this draft?", ck_confirm_label: "Discard", ck_confirm_tone: "danger" } %>
      <%= button_to "Publish this version", publish_draft_metric_path(metric, draft_id: edit_draft.id),
            method: :post, form_class: "inline-block",
            class: ck_button_classes(:dark) %>
    </div>
  </div>
<% end %>

<% if suggestion %>
  <div class="ck-suggestion-banner" role="status">
    <div class="ck-suggestion-banner__body">
      <p class="ck-kicker ck-kicker--icon"><%= heroicon_tag "sparkles", variant: :outline, class: "ck-magic-icon", "aria-hidden": "true" %>Proposed changes</p>
      <p class="ck-meta-copy">Based on human reviews, here are some proposed changes to the metric.</p>
    </div>
    <div class="ck-suggestion-banner__actions">
      <%= button_to suggest_variants_metric_path(metric, back_to: "edit"),
            method: :post, form_class: "inline-block", class: "ck-icon-btn",
            title: "Try again", "aria-label": "Try again",
            data: { turbo_confirm: "Replace these changes with fresh ones from the model?" } do %><%= heroicon_tag "arrow-path", variant: :outline, size: 16, "aria-hidden": "true" %><% end %>
      <%= button_to dismiss_suggestion_metric_path(metric, draft_id: suggestion.id, back_to: "edit"),
            method: :delete, form_class: "inline-block", class: "ck-icon-btn",
            title: "Discard these changes", "aria-label": "Discard",
            data: { turbo_confirm: "Drop these changes?", ck_confirm_label: "Discard", ck_confirm_tone: "danger" } do %><%= heroicon_tag "trash", variant: :outline, size: 16, "aria-hidden": "true" %><% end %>
      <%= button_to "Apply all", publish_draft_metric_path(metric, draft_id: suggestion.id),
            method: :post, form_class: "inline-block",
            class: ck_button_classes(:dark) %>
    </div>
  </div>
<% end %>

<%= form_with(model: metric, local: true) do |form| %>
  <% if metric.errors.any? %>
    <div class="ck-flash ck-flash--alert" role="alert">
      <p class="ck-flash__title"><%= pluralize(metric.errors.count, "problem") %> prevented this metric from being saved.</p>
      <ul class="ck-error-list">
        <% metric.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="ck-card ck-form-card">
    <div class="ck-field">
      <%= form.label :name, "Metric name", class: "ck-label" %>
      <%= form.text_field :name, class: "ck-input", placeholder: "Helpfulness", **ck_field_aria(form, :name) %>
      <%= ck_field_error(form, :name) %>
    </div>

    <% editing = metric.persisted? %>
    <% show_judge = !editing || metric.llm_judge? %>
    <% show_check = !editing || metric.check? %>

    <% if editing %>
      <%= form.hidden_field :metric_type %>
    <% else %>
      <div class="ck-field" data-ck-metric-type>
        <p class="ck-section-title">Metric type</p>
        <p class="ck-hint">The judge gives each response 1 to 5 stars against your rubric. A check just passes or fails, with no AI.</p>
        <label class="ck-radio">
          <%= form.radio_button :metric_type, "llm_judge", checked: !metric.check? %>
          <span>LLM judge (1-5)</span>
        </label>
        <label class="ck-radio">
          <%= form.radio_button :metric_type, "check", checked: metric.check? %>
          <span>Deterministic check</span>
        </label>
      </div>
    <% end %>

    <% if show_judge %>
    <div class="ck-field ck-field--spacious" data-ck-metric-editor="llm_judge" <%= "hidden" if metric.check? %>>
      <p class="ck-section-title">Instruction</p>
      <p class="ck-hint">What should the judge assess? This instruction is sent to the LLM judge when scoring outputs.</p>
      <%= form.text_area :instruction, rows: 8, class: "ck-input ck-input--area", placeholder: "Evaluate whether the output...", **ck_field_aria(form, :instruction) %>
      <%= ck_field_error(form, :instruction) %>

      <% if instruction_changed %>
        <div class="ck-inline-suggestion">
          <div class="ck-inline-suggestion__head">
            <p class="ck-kicker">Suggested wording</p>
            <button type="button"
                    class="<%= ck_button_classes(:light, variant: :outline) %> ck-inline-suggestion__apply"
                    data-ck-apply
                    data-target="metric[instruction]"
                    data-value="<%= h(suggested_instruction) %>">Use this wording</button>
          </div>
          <div class="ck-inline-suggestion__diff">
            <pre class="ck-inline-suggestion__pane ck-inline-suggestion__pane--before"><%= ck_word_diff_old(metric.instruction.to_s, suggested_instruction) %></pre>
            <pre class="ck-inline-suggestion__pane ck-inline-suggestion__pane--after"><%= ck_word_diff_new(metric.instruction.to_s, suggested_instruction) %></pre>
          </div>
        </div>
      <% end %>
    </div>

    <div class="ck-field ck-field--spacious" data-ck-metric-editor="llm_judge" <%= "hidden" if metric.check? %>>
      <p class="ck-section-title">Rubric<%= render "completion_kit/metrics/rubric_hint" %></p>
      <p class="ck-hint">What each star rating means for this metric.</p>

      <div class="ck-rubric-builder">
        <% metric.rubric_bands_for_form.each_with_index do |band, index| %>
          <% suggested_band = suggestion_bands[band["stars"].to_i].to_s %>
          <% band_changed = suggestion && suggested_band.present? && suggested_band != band["description"].to_s %>
          <% target_name = "metric[rubric_bands][#{index}][description]" %>
          <div class="ck-rubric-row">
            <div class="ck-rubric-row__stars">
              <% 5.times do |i| %>
                <svg viewBox="0 0 24 24" width="16" height="16" stroke-width="1.75" class="ck-star <%= i < band["stars"] ? "ck-star--filled" : "ck-star--empty" %>"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              <% end %>
              <input type="hidden" name="metric[rubric_bands][<%= index %>][stars]" value="<%= band["stars"] %>">
            </div>
            <div class="ck-rubric-row__fields">
              <textarea name="<%= target_name %>" rows="2" class="ck-input ck-input--area" aria-label="Rubric description for the <%= band["stars"] %>-star rating"><%= band["description"] %></textarea>
              <% if band_changed %>
                <div class="ck-inline-suggestion ck-inline-suggestion--band">
                  <div class="ck-inline-suggestion__head">
                    <p class="ck-kicker">Suggested band</p>
                    <button type="button"
                            class="<%= ck_button_classes(:light, variant: :outline) %> ck-inline-suggestion__apply"
                            data-ck-apply
                            data-target="<%= target_name %>"
                            data-value="<%= h(suggested_band) %>">Use this band</button>
                  </div>
                  <div class="ck-inline-suggestion__diff">
                    <pre class="ck-inline-suggestion__pane ck-inline-suggestion__pane--before"><%= ck_word_diff_old(band["description"].to_s, suggested_band) %></pre>
                    <pre class="ck-inline-suggestion__pane ck-inline-suggestion__pane--after"><%= ck_word_diff_new(band["description"].to_s, suggested_band) %></pre>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
    <% end %>

    <% if show_check %>
    <% check = metric.check_config || {} %>
    <div class="ck-field ck-field--spacious" data-ck-metric-editor="check" <%= "hidden" unless metric.check? %>>
      <p class="ck-section-title">Check</p>
      <p class="ck-hint">A pass or fail rule with no AI and no cost. You only fill in the fields the chosen rule needs.</p>

      <div class="ck-field">
        <p class="ck-label" id="metric_check_kind_label">Rule</p>
        <%= render "completion_kit/shared/branded_select",
                   name: "metric[check_config][check_kind]",
                   options: CompletionKit::Checks::Registry.kinds.map { |kind| [kind, ck_check_kind_label(kind)] },
                   selected: check["check_kind"] || CompletionKit::Checks::Registry.kinds.first,
                   labelledby: "metric_check_kind_label" %>
      </div>

      <div class="ck-field">
        <p class="ck-label" id="metric_check_target_label">What to check</p>
        <%= render "completion_kit/shared/branded_select",
                   name: "metric[check_config][target]",
                   options: CompletionKit::Checks::TargetResolver::TARGETS.map { |target| [target, ck_check_target_label(target)] },
                   selected: check["target"] || CompletionKit::Checks::TargetResolver::TARGETS.first,
                   labelledby: "metric_check_target_label" %>
      </div>

      <div class="ck-field" data-ck-check-field="target_path">
        <label class="ck-label" for="metric_check_target_path">Path into the JSON</label>
        <p class="ck-hint">Where to look inside the response, like data.items.0.name.</p>
        <input type="text" name="metric[check_config][target_path]" id="metric_check_target_path" class="ck-input" value="<%= check["target_path"] %>">
      </div>

      <div class="ck-field" data-ck-check-field="compare_to">
        <p class="ck-label">Compare against</p>
        <p class="ck-hint">Check every output against one fixed value, or against each row's own expected value (its answer key).</p>
        <label class="ck-radio">
          <input type="radio" name="metric[check_config][compare_to]" value="constant" <%= "checked" unless check["compare_to"] == "expected" %>>
          <span>A value I type</span>
        </label>
        <label class="ck-radio">
          <input type="radio" name="metric[check_config][compare_to]" value="expected" <%= "checked" if check["compare_to"] == "expected" %>>
          <span>Each row's expected value</span>
        </label>
      </div>

      <div class="ck-field" data-ck-check-field="value">
        <label class="ck-label" for="metric_check_value">Text to look for</label>
        <input type="text" name="metric[check_config][value]" id="metric_check_value" class="ck-input" value="<%= check["value"] %>">
      </div>

      <div class="ck-field" data-ck-check-field="pattern">
        <label class="ck-label" for="metric_check_pattern">Pattern</label>
        <p class="ck-hint">A regular expression to match against.</p>
        <input type="text" name="metric[check_config][pattern]" id="metric_check_pattern" class="ck-input" value="<%= check["pattern"] %>">
      </div>

      <div class="ck-field" data-ck-check-field="json_path">
        <label class="ck-label" for="metric_check_json_path">JSON path</label>
        <p class="ck-hint">The path to the value inside the response, like data.status.</p>
        <input type="text" name="metric[check_config][json_path]" id="metric_check_json_path" class="ck-input" value="<%= check["json_path"] %>">
      </div>

      <div class="ck-field" data-ck-check-field="expected">
        <label class="ck-label" for="metric_check_expected">Expected value</label>
        <p class="ck-hint">The value it should equal.</p>
        <input type="text" name="metric[check_config][expected]" id="metric_check_expected" class="ck-input" value="<%= check["expected"] %>">
      </div>

      <div class="ck-field" data-ck-check-field="expected_path">
        <label class="ck-label" for="metric_check_expected_path">Field in the answer key</label>
        <p class="ck-hint">Optional. If the expected value is JSON, name the field to read from it, like data.answer. Leave blank to compare against the whole value.</p>
        <input type="text" name="metric[check_config][expected_path]" id="metric_check_expected_path" class="ck-input" value="<%= check["expected_path"] %>">
      </div>

      <div class="ck-field-row">
        <div class="ck-field" data-ck-check-field="min">
          <label class="ck-label" for="metric_check_min">Shortest allowed</label>
          <input type="number" name="metric[check_config][min]" id="metric_check_min" class="ck-input" value="<%= check["min"] %>">
        </div>
        <div class="ck-field" data-ck-check-field="max">
          <label class="ck-label" for="metric_check_max">Longest allowed</label>
          <input type="number" name="metric[check_config][max]" id="metric_check_max" class="ck-input" value="<%= check["max"] %>">
        </div>
      </div>

      <label class="ck-checkbox" data-ck-check-field="case_sensitive">
        <input type="checkbox" name="metric[check_config][case_sensitive]" value="true"<%= " checked" if check["case_sensitive"] %>>
        <span>Case sensitive</span>
      </label>
      <label class="ck-checkbox" data-ck-check-field="multiline">
        <input type="checkbox" name="metric[check_config][multiline]" value="true"<%= " checked" if check["multiline"] %>>
        <span>Multiline</span>
      </label>
      <label class="ck-checkbox" data-ck-check-field="trim">
        <input type="checkbox" name="metric[check_config][trim]" value="true"<%= " checked" if check["trim"] %>>
        <span>Trim whitespace</span>
      </label>
    </div>
    <% end %>

    <%= render "completion_kit/tags/picker", record: metric, param_namespace: :metric %>

    <div class="ck-actions">
      <% if metric.persisted? %>
        <%= ck_delete_trigger(form_id: metric_delete_id, label: "Delete metric", confirm: metric_delete_confirm) %>
      <% end %>
      <%= link_to "Cancel", metrics_path, class: ck_button_classes(:light, variant: :outline), tabindex: "0" %>
      <%= form.submit(metric.persisted? ? "Save metric" : "Create metric", class: ck_button_classes(:dark)) %>
    </div>
  </div>
<% end %>

<% if metric.persisted? %>
  <%= render "completion_kit/shared/delete_form", form_id: metric_delete_id, path: metric_path(metric) %>
<% end %>
