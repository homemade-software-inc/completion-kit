<ol class="ck-breadcrumb" aria-label="Breadcrumb">
  <li><%= link_to "Metrics", metrics_path %></li>
  <li><%= link_to @metric.name, metric_path(@metric) %></li>
  <li>Suggested improvements</li>
</ol>

<section class="ck-page-header">
  <div>
    <p class="ck-kicker">Suggested improvements</p>
    <h1 class="ck-title"><%= @metric.name %></h1>
    <p class="ck-lead">The model proposed these alternative instructions based on the verdicts you've collected. Pick one to make it the live judge instruction. The previous version stays in history.</p>
  </div>
  <div class="ck-actions">
    <%= link_to "Back to metric", metric_path(@metric), class: ck_button_classes(:light, variant: :outline) %>
  </div>
</section>

<% if @suggestion_drafts.empty? %>
  <div class="ck-empty">
    <p>No pending suggestions. Hit <strong>Improve the metric</strong> on the metric page to generate some.</p>
  </div>
<% else %>
  <% current_instruction = @published_judge_version&.instruction.to_s %>
  <% @suggestion_drafts.each_with_index do |draft, idx| %>
    <section class="ck-card ck-card--spaced">
      <div class="ck-prompt-preview__header">
        <p class="ck-kicker">Option <%= idx + 1 %> of <%= @suggestion_drafts.size %></p>
        <time class="ck-meta-copy" data-relative-time datetime="<%= draft.created_at.utc.iso8601 %>"><%= time_ago_in_words(draft.created_at) %> ago</time>
      </div>

      <div class="ck-suggest-diff">
        <div class="ck-suggest-diff__pane">
          <div class="ck-suggest-diff__header">
            <span class="ck-suggest-diff__label ck-suggest-diff__label--before">Currently live</span>
          </div>
          <pre class="ck-suggest-diff__code"><%= ck_word_diff_old(current_instruction, draft.instruction.to_s) %></pre>
        </div>
        <div class="ck-suggest-diff__pane">
          <div class="ck-suggest-diff__header">
            <span class="ck-suggest-diff__label ck-suggest-diff__label--after">Option <%= idx + 1 %></span>
          </div>
          <pre class="ck-suggest-diff__code"><%= ck_word_diff_new(current_instruction, draft.instruction.to_s) %></pre>
        </div>
      </div>

      <div class="ck-actions">
        <%= button_to "Dismiss", dismiss_suggestion_metric_path(@metric, draft_id: draft.id),
              method: :delete, form_class: "inline-block",
              class: ck_button_classes(:light, variant: :outline),
              data: { turbo_confirm: "Drop this option?" } %>
        <%= button_to "Use this version", publish_draft_metric_path(@metric, draft_id: draft.id),
              method: :post, form_class: "inline-block",
              class: ck_button_classes(:dark) %>
      </div>
    </section>
  <% end %>
<% end %>
