<% content_for :ck_title, @run.name %>
<%= turbo_stream_from "completion_kit_run_#{@run.id}" %>

<ol class="ck-breadcrumb">
  <li><%= link_to "Runs", runs_path %></li>
  <li><%= @run.name %></li>
</ol>

<%= render "status_header", run: @run %>

<% if @run.tags.any? %>
  <div class="tag-marks-row tag-marks-row--header">
    <%= render "completion_kit/tags/marks", tags: @run.tags %>
  </div>
<% end %>


<% if CompletionKit.config.judge_agreement_enabled %>
  <% stale_summary = @run.stale_review_summary %>
  <% if stale_summary.any? %>
    <div class="ck-stale-versions-banner" role="status">
      <div class="ck-stale-versions-banner__body">
        <p class="ck-kicker">Stale metric versions</p>
        <p class="ck-meta-copy">
          This run was scored against metric versions that are no longer live.
          <% stale_summary.values.each_with_index do |s, i| %>
            <%= ", " if i > 0 %><strong><%= s[:metric_name] %></strong> (scored by <%= s[:scored_labels].join(", ") %>; live is <%= s[:current_label] %>)<% end %>.
          Re-grade to refresh the scores with the current metrics.
        </p>
      </div>
      <% if @run.status == "completed" %>
        <div class="ck-banner-actions">
          <div class="ck-banner-action">
            <%= button_to "Re-grade with current metrics",
                  regrade_run_path(@run), method: :post,
                  class: ck_button_classes(:dark), form_class: "inline-block",
                  data: { turbo_confirm: "Re-grade this run's existing responses against the current metrics?" } %>
            <p class="ck-banner-action__note">Re-scores the responses you already have. No generation cost.</p>
          </div>
          <div class="ck-banner-action">
            <%= button_to "Re-run from scratch",
                  rerun_run_path(@run), method: :post,
                  class: ck_button_classes(:light, variant: :outline), form_class: "inline-block",
                  data: { turbo_confirm: "Create a new run with fresh responses and the current metrics? The original run stays as a record." } %>
            <p class="ck-banner-action__note">Generates fresh responses first. Costs a full run.</p>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>

<%= render "run_config", run: @run %>

<% if @run.prompt %>
  <div class="ck-prompt-preview">
    <div class="ck-prompt-preview__header">
      <p class="ck-kicker">Prompt</p>
      <% latest_suggestion = @run.suggestions.order(created_at: :desc).first %>
      <% if latest_suggestion %>
        <%= link_to "View suggestion", suggestion_path(latest_suggestion, from: "run"), class: ck_button_classes(:light, variant: :outline) + " ck-button--sm" %>
      <% elsif @run.status == "completed" && @run.responses.joins(:reviews).exists? %>
        <%= button_to suggest_run_path(@run), method: :post, class: ck_button_classes(:light, variant: :outline) + " ck-button--sm", form_class: "inline-block" do %>
          <%= heroicon_tag "sparkles", variant: :outline, class: "ck-magic-icon", "aria-hidden": "true" %>
          Suggest improvements
        <% end %>
      <% end %>
    </div>
    <p class="ck-prompt-preview__text" id="prompt_text"><%= @run.prompt.template %></p>
    <% if @run.prompt.template.length > 200 %>
      <button type="button" class="ck-disclosure-toggle" id="prompt_toggle" aria-expanded="false" aria-controls="prompt_text" onclick="var t=document.getElementById('prompt_text');var l=this;var expanded=t.classList.toggle('ck-prompt-preview__text--expanded');l.firstChild.textContent=expanded?'Show less':'Show more';l.setAttribute('aria-expanded',expanded?'true':'false')"><span>Show more</span></button>
    <% end %>
  </div>
<% else %>
  <div class="ck-prompt-preview">
    <div class="ck-prompt-preview__header">
      <p class="ck-kicker">Output source</p>
    </div>
    <p class="ck-prompt-preview__text">Dataset column <code><%= @run.output_column.presence || "actual_output" %></code>. No prompt generated these outputs.</p>
  </div>
<% end %>

<% if @run.dataset %>
  <dialog id="dataset-preview-<%= @run.id %>" class="ck-modal" aria-labelledby="dataset-preview-title-<%= @run.id %>" onclick="if(event.target===this)this.close()">
    <article class="ck-modal__panel" tabindex="-1" autofocus onclick="event.stopPropagation()">
      <header class="ck-modal__header">
        <div class="ck-modal__heading">
          <h2 class="ck-modal__title" id="dataset-preview-title-<%= @run.id %>"><%= @run.dataset.name %></h2>
          <span class="ck-modal__meta"><%= @run.dataset.row_count %> rows</span>
        </div>
        <button type="button" class="ck-modal__close" aria-label="Close" onclick="this.closest('dialog').close()">×</button>
      </header>
      <div class="ck-modal__body">
        <%
          require "csv"
          parse_error = nil
          headers = []
          body_rows = []
          remaining = 0
          begin
            reader = ::CSV.new(@run.dataset.csv_data.to_s)
            headers = reader.shift || []
            50.times do
              row = reader.shift
              break unless row
              body_rows << row
            end
            remaining = [@run.dataset.row_count - body_rows.length, 0].max
          rescue ::CSV::MalformedCSVError => e
            parse_error = e.message
          end
        %>
        <% if parse_error %>
          <p class="ck-field-hint" style="color: var(--ck-warning); padding: 1rem;">Could not parse CSV: <%= parse_error %></p>
        <% elsif headers.empty? %>
          <p class="ck-field-hint" style="padding: 1rem;">Dataset is empty.</p>
        <% else %>
          <div class="ck-csv-table-wrap">
            <table class="ck-csv-table">
              <thead>
                <tr>
                  <th class="ck-csv-table__rownum">#</th>
                  <% headers.each do |h| %>
                    <th><%= h %></th>
                  <% end %>
                </tr>
              </thead>
              <tbody>
                <% body_rows.each_with_index do |row, idx| %>
                  <tr>
                    <td class="ck-csv-table__rownum"><%= idx + 1 %></td>
                    <% headers.each_with_index do |_, i| %>
                      <td><span class="ck-csv-cell"><%= row[i] %></span></td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <% if remaining > 0 %>
            <p class="ck-modal__meta" style="margin: 0.65rem 0 0; padding: 0 0.25rem;"><%= remaining %> more rows in the full dataset.</p>
          <% end %>
        <% end %>
      </div>
      <footer class="ck-modal__footer">
        <%= link_to "Open dataset", dataset_path(@run.dataset), class: ck_button_classes(:light, variant: :outline) %>
      </footer>
    </article>
  </dialog>
<% end %>

<%= render "status_panel", run: @run %>

<%= render "sort_toolbar", run: @run %>

<%= render "responses_region", run: @run, responses: @responses, responses_offset: @responses_offset %>

<% if @responses_total_pages > 1 %>
  <nav class="ck-pagination" aria-label="Response pages">
    <% if @responses_page > 1 %>
      <%= link_to run_path(@run, page: @responses_page - 1, sort: params[:sort]), class: ck_button_classes(:light, variant: :outline) do %>&larr; Prev<% end %>
    <% end %>
    <span class="ck-meta-copy">Page <%= @responses_page %> of <%= @responses_total_pages %> &middot; <%= pluralize(@responses_total, "response") %></span>
    <% if @responses_page < @responses_total_pages %>
      <%= link_to run_path(@run, page: @responses_page + 1, sort: params[:sort]), class: ck_button_classes(:light, variant: :outline) do %>Next &rarr;<% end %>
    <% end %>
  </nav>
<% end %>

<% if @run.status.in?(%w[pending running]) %>
  <script>
    (function() {
      if (window.ckRunStatusPoll) clearInterval(window.ckRunStatusPoll);
      var url = '<%= refresh_status_run_path(@run) %>';
      var refresh = function() {
        fetch(url, { headers: { Accept: 'text/vnd.turbo-stream.html' }, credentials: 'same-origin' })
          .then(function(r) { return r.ok ? r.text() : null; })
          .then(function(html) { if (html) Turbo.renderStreamMessage(html); })
          .catch(function() {});
      };
      setTimeout(refresh, 1000);
      window.ckRunStatusPoll = setInterval(refresh, 15000);
    })();
  </script>
<% end %>
