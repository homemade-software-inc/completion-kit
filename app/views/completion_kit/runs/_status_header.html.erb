<div id="run_status_header" aria-live="polite">
  <% if run.status == "failed" %>
    <div class="ck-flash ck-flash--alert" role="alert">
      <%= run.failure_summary.presence || run.error_message.presence || "Run failed." %>
    </div>
  <% end %>

  <% if run.status == "running" && !CompletionKit::WorkerHealth.healthy? %>
    <div class="ck-banner ck-banner--warn">
      <strong class="ck-banner__title">No worker is processing jobs</strong>
      <p class="ck-banner__body">Jobs are queued but nothing is consuming them. Start <code class="ck-banner__code">bin/jobs</code> (or your worker service) to resume.</p>
    </div>
  <% end %>

  <% if run.scores_at_ceiling? %>
    <div class="ck-score-ceiling-banner" role="status">
      <div class="ck-score-ceiling-banner__body">
        <p class="ck-kicker">Scores are clustered near the top</p>
        <p class="ck-meta-copy">
          A near-perfect average usually means the judge is not separating good output from bad, not that every
          output is good. Check it against your own reading before you trust the number.
        </p>
      </div>
      <div class="ck-score-ceiling-banner__actions">
        <%= link_to "Worst first", run_path(run, sort: "score_asc"),
              class: ck_button_classes(:light, variant: :outline) + " ck-button--sm",
              title: "Sort the responses lowest score first to see whether the judge ever penalises anything." %>
        <% if CompletionKit.config.judge_agreement_enabled && run.calibratable_metric %>
          <%= link_to "Check the judge", metric_path(run.calibratable_metric, anchor: "agreement"),
                class: ck_button_classes(:dark) + " ck-button--sm",
                title: "Score a few outputs yourself and see how often the judge agrees with you." %>
        <% end %>
      </div>
    </div>
  <% end %>

  <section class="ck-page-header">
    <div>
      <span class="ck-status-badge ck-status-badge--<%= run.status %>">
        <span class="ck-status-badge__dot" aria-hidden="true"></span>
        <span class="ck-status-badge__label"><%= run.status.upcase %></span>
      </span>
      <h1 class="ck-title"><%= run.name %></h1>
      <% if run.prompt %>
        <p class="ck-meta-copy"><%= link_to run.prompt.display_name, prompt_path(run.prompt), class: "ck-link" %>&ensp;<span class="ck-chip" style="text-transform: none;"><%= run.prompt.llm_model %></span></p>
      <% else %>
        <p class="ck-meta-copy">Scoring existing outputs, grading column <code><%= run.output_column.presence || "actual_output" %></code><% if run.dataset %> on <%= link_to run.dataset.name, dataset_path(run.dataset), class: "ck-link" %><% end %></p>
      <% end %>
    </div>
    <%= render "completion_kit/runs/actions", run: run %>
  </section>
</div>
