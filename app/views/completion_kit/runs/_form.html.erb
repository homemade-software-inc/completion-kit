<%= form_with(model: run, local: true) do |form| %>
  <% if run.errors.any? %>
    <div class="ck-flash ck-flash--alert" role="alert">
      <p class="ck-flash__title"><%= pluralize(run.errors.count, "problem") %> prevented this run from being saved.</p>
      <ul class="ck-error-list">
        <% run.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="ck-card ck-form-card">
    <div class="ck-field">
      <%= form.label :name, "Name (auto-generated if blank)", class: "ck-label" %>
      <%= form.text_field :name, class: "ck-input", placeholder: run.name.presence || "Auto-generated from prompt + version + timestamp", **ck_field_aria(form, :name) %>
      <%= ck_field_error(form, :name) %>
    </div>

    <div class="ck-field">
      <label class="ck-checkbox-label">
        <%= check_box_tag "run[judge_only]", "1", local_assigns[:judge_only] || (run.persisted? && run.judge_only?), id: "run_judge_only", class: "ck-checkbox" %>
        <span class="ck-checkbox-label__box" aria-hidden="true"></span>
        <span class="ck-checkbox-label__body">
          <span class="ck-checkbox-label__text">Score existing outputs</span>
          <span class="ck-checkbox-label__hint">Grade an existing column on the dataset instead of running a prompt. Roughly half the LLM calls per row.</span>
        </span>
      </label>
    </div>

    <div class="ck-field" id="prompt-field">
      <%= form.label :prompt_id, "Prompt", class: "ck-label" %>
      <%= form.select :prompt_id,
            @prompts.map { |p|
              vars = p.variables
              label_parts = [p.display_name, p.llm_model]
              label_parts << (vars.any? ? "#{vars.size} #{'var'.pluralize(vars.size)}" : "no vars")
              [
                label_parts.join(" · "),
                p.id,
                {
                  "data-has-variables" => vars.any? ? "1" : "0",
                  "data-model" => p.llm_model.to_s,
                  "data-variables" => vars.join(", "),
                  "data-description" => p.description.to_s,
                  "data-template-preview" => p.template.to_s.truncate(220, separator: " ")
                }
              ]
            },
            { include_blank: "Select a prompt" },
            { class: "ck-input", id: "run_prompt_id" } %>
      <div class="ck-prompt-summary" id="prompt-summary" hidden>
        <p class="ck-prompt-summary__description" id="prompt-summary-description" hidden></p>
        <p class="ck-prompt-summary__template" id="prompt-summary-template"></p>
      </div>
    </div>

    <div class="ck-field" id="output-column-field" hidden>
      <%= form.label :output_column, "Output column", class: "ck-label" %>
      <%= form.text_field :output_column, value: run.output_column.presence || "actual_output", class: "ck-input", id: "run_output_column", placeholder: "actual_output", **ck_field_aria(form, :output_column) %>
      <%= ck_field_error(form, :output_column) %>
      <p class="ck-field-hint">Name of the dataset column whose value will be graded as the response. Defaults to <code>actual_output</code>.</p>
    </div>

    <div class="ck-field" id="dataset-field">
      <%= form.label :dataset_id, "Dataset", class: "ck-label" %>
      <% if @datasets.empty? %>
        <p class="ck-meta-copy">No datasets yet. <%= link_to "Create a dataset", new_dataset_path, class: "ck-link" %> first.</p>
      <% else %>
        <%= form.select :dataset_id,
              @datasets.map { |d| [d.name, d.id, { "data-headers" => d.headers.join(",") }] },
              { include_blank: "Select a dataset" },
              { class: "ck-input", id: "run_dataset_id" } %>
      <% end %>
      <p class="ck-field-hint" id="dataset-hint"></p>
    </div>

    <div class="ck-field" id="expected-column-field">
      <%= form.label :expected_column, "Answer-key column", class: "ck-label" %>
      <%= form.text_field :expected_column, class: "ck-input", id: "run_expected_column", placeholder: "expected_output", **ck_field_aria(form, :expected_column) %>
      <%= ck_field_error(form, :expected_column) %>
      <p class="ck-field-hint" id="expected-column-hint">Optional. The dataset column holding each row's correct answer, used by the judge and by checks set to compare against the row's expected value. Defaults to <code>expected_output</code>.</p>
      <p class="ck-field-hint" id="expected-column-warn"></p>
    </div>

    <div class="ck-field">
      <label class="ck-label" for="run_max_tokens" style="position: relative;">
        Max tokens<span class="ck-info-toggle" tabindex="0">?</span><span class="ck-info-popup">The ceiling on how many tokens the model may generate per row. Leave it blank to use the provider's default. Set it when your prompt produces long output: if generation hits the cap the response is cut off mid-sentence, and the judge scores the truncation rather than the prompt. Match whatever your production caller uses so the evaluation reflects reality.</span>
      </label>
      <%= form.number_field :max_tokens, min: 1, step: 1, class: "ck-input", id: "run_max_tokens", placeholder: "Provider default", **ck_field_aria(form, :max_tokens) %>
      <%= ck_field_error(form, :max_tokens) %>
    </div>

    <div class="ck-field" id="judge-field">
      <label class="ck-label" for="run_judge_model" style="position: relative;">
        Judge model<span class="ck-info-toggle" tabindex="0">?</span><span class="ck-info-popup">Judge models score generated responses against your metrics. Pick one when configuring a run.</span>
      </label>
      <% available = CompletionKit::ApiConfig.available_models(scope: :judging) %>
      <% if available.any? %>
        <div class="ck-select-with-action">
          <%= form.select :judge_model, ck_grouped_models(available, run.judge_model, rejected: run.errors[:judge_model].any?), { include_blank: "None" }, { class: "ck-input", id: "run_judge_model", **ck_field_aria(form, :judge_model) } %>
          <% ck_refreshing = CompletionKit::ProviderCredential.discovery_in_progress? %>
          <button type="button" class="ck-icon-btn<%= ' ck-icon-btn--spinning' if ck_refreshing %>" title="Refresh models" <%= 'disabled' if ck_refreshing %> data-ck-refresh-models><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" width="16" height="16"><path fill-rule="evenodd" d="M13.836 2.477a.75.75 0 0 1 .75.75v3.182a.75.75 0 0 1-.75.75h-3.182a.75.75 0 0 1 0-1.5h1.37l-.84-.841a4.5 4.5 0 0 0-7.08.681.75.75 0 0 1-1.264-.808 6 6 0 0 1 9.44-.908l.84.84V3.227a.75.75 0 0 1 .75-.75Zm-.911 7.5A.75.75 0 0 1 13.199 11a6 6 0 0 1-9.44.908l-.84-.84v1.68a.75.75 0 0 1-1.5 0V9.567a.75.75 0 0 1 .75-.75h3.182a.75.75 0 0 1 0 1.5h-1.37l.84.841a4.5 4.5 0 0 0 7.08-.681.75.75 0 0 1 1.024-.274Z" clip-rule="evenodd"/></svg></button>
        </div>
        <%= ck_field_error(form, :judge_model) %>
        <p class="ck-field-hint" id="judge-hint"></p>
        <div hidden data-refresh-progress-carriers data-ck-refresh-url="<%= refresh_models_path %>" data-ck-statuses-url="<%= statuses_provider_credentials_path %>">
          <% CompletionKit::ProviderCredential.find_each do |pc| %>
            <%= turbo_stream_from "completion_kit_provider_#{pc.id}" %>
            <%= render "completion_kit/provider_credentials/discovery_status", provider_credential: pc, show_completed: false %>
          <% end %>
        </div>
        <p class="ck-field-hint" id="refresh-status" role="status" aria-live="polite" style="min-height: 1.2em; margin-top: -0.25rem; font-size: 0.75rem;">&nbsp;</p>
      <% else %>
        <p class="ck-field-hint" style="color: var(--ck-warning);">No judge models available.&ensp;<%= link_to "Add a provider", provider_credentials_path, class: "ck-link" %></p>
        <%= form.hidden_field :judge_model, id: "run_judge_model" %>
      <% end %>
    </div>


    <div class="ck-field" id="metrics-field">
      <p class="ck-label" id="run_metrics_label">Metrics</p>
      <% if @all_metrics.empty? %>
        <p class="ck-field-hint" style="color: var(--ck-warning);">No metrics yet.&ensp;<%= link_to "Create a metric", new_metric_path, class: "ck-link" %></p>
      <% else %>
        <p class="ck-field-hint" id="metrics-hint"></p>
        <% if @metric_groups.any? %>
          <div class="ck-metric-groups">
            <span class="ck-metric-groups__label">Groups</span>
            <div class="ck-metric-groups__row">
              <% @metric_groups.each do |g| %>
                <button type="button"
                        class="ck-metric-group-pill"
                        data-metric-group
                        data-metric-ids="<%= g.metric_ids.join(",") %>">
                  <span class="ck-metric-group-pill__check" aria-hidden="true">✓</span>
                  <span class="ck-metric-group-pill__label"><%= g.name %></span>
                  <span class="ck-metric-group-pill__count"><%= g.metric_ids.size %></span>
                </button>
              <% end %>
            </div>
          </div>
          <div class="ck-metric-divider"><span>or pick individually</span></div>
        <% end %>

        <% available_filter_tags = @all_metrics.flat_map(&:tags).uniq.sort_by(&:name) %>
        <% if available_filter_tags.any? %>
          <div class="ck-metric-tag-filter" data-metric-tag-filter>
            <span class="ck-metric-tag-filter__label">Filter metrics by tag</span>
            <% available_filter_tags.each do |tag| %>
              <button type="button"
                      class="tag-mark tag-mark--off ck-metric-tag-filter__chip"
                      style="--mark-color: var(--tag-<%= tag.color %>);"
                      data-filter-tag="<%= tag.name %>"><%= tag.name %></button>
            <% end %>
          </div>
        <% end %>

        <%= hidden_field_tag "run[metric_ids][]", "", id: nil %>
        <div class="ck-metric-checkboxes" data-metric-checkboxes role="group" aria-labelledby="run_metrics_label">
          <% @all_metrics.each do |metric| %>
            <label class="ck-checkbox-label" data-metric-tags="<%= metric.tag_names.join(",") %>" data-needs-judge="<%= metric.llm_judge? ? "1" : "0" %>" data-compare-expected="<%= metric.check? && metric.check_config.to_h["compare_to"] == "expected" ? "1" : "0" %>">
              <%= check_box_tag "run[metric_ids][]", metric.id, run.selected_metric_ids.include?(metric.id), class: "ck-checkbox", id: "run_metric_#{metric.id}" %>
              <span class="ck-checkbox-label__box" aria-hidden="true"></span>
              <span class="ck-checkbox-label__body">
                <span class="ck-checkbox-label__text"><%= metric.name %></span>
                <% if metric.instruction.present? %>
                  <span class="ck-checkbox-label__hint"><%= truncate(metric.instruction.to_s, length: 90) %></span>
                <% end %>
                <% if metric.tags.any? %>
                  <div class="tag-marks-row">
                    <%= render "completion_kit/tags/marks", tags: metric.tags %>
                  </div>
                <% end %>
              </span>
            </label>
          <% end %>
        </div>
      <% end %>
    </div>

    <%= render "completion_kit/tags/picker", record: run, param_namespace: :run %>

    <div class="ck-actions">
      <%= link_to "Cancel", run.persisted? ? run_path(run) : runs_path, class: ck_button_classes(:light, variant: :outline), tabindex: "0" %>
      <%= form.submit(run.persisted? ? "Save run" : "Create run", class: ck_button_classes(:dark), id: "run-submit") %>
    </div>
  </div>
<% end %>
