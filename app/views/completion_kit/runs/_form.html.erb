<%= form_with(model: run, local: true) do |form| %>
  <% if run.errors.any? %>
    <div class="ck-flash ck-flash--alert">
      <p class="ck-flash__title"><%= pluralize(run.errors.count, "problem") %> prevented this run from being saved.</p>
      <ul class="ck-error-list">
        <% run.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="ck-card ck-form-card">
    <div class="ck-field">
      <%= form.label :name, "Name (auto-generated if blank)", class: "ck-label" %>
      <%= form.text_field :name, class: "ck-input", placeholder: run.name.presence || "Auto-generated from prompt + version + timestamp" %>
    </div>

    <div class="ck-field">
      <label class="ck-checkbox-label">
        <%= check_box_tag "run[judge_only]", "1", run.persisted? && run.judge_only?, id: "run_judge_only", class: "ck-checkbox" %>
        <span class="ck-checkbox-label__box" aria-hidden="true"></span>
        <span class="ck-checkbox-label__body">
          <span class="ck-checkbox-label__text">Judge-only run</span>
          <span class="ck-checkbox-label__hint">Grade an existing column on the dataset instead of running a prompt. Roughly half the LLM calls per row.</span>
        </span>
      </label>
    </div>

    <div class="ck-field" id="prompt-field">
      <%= form.label :prompt_id, "Prompt", class: "ck-label" %>
      <%= form.select :prompt_id,
            @prompts.map { |p|
              vars = p.variables
              label_parts = [p.display_name, p.llm_model]
              label_parts << (vars.any? ? "#{vars.size} #{'var'.pluralize(vars.size)}" : "no vars")
              [
                label_parts.join(" · "),
                p.id,
                {
                  "data-has-variables" => vars.any? ? "1" : "0",
                  "data-model" => p.llm_model.to_s,
                  "data-variables" => vars.join(", "),
                  "data-description" => p.description.to_s,
                  "data-template-preview" => p.template.to_s.truncate(220, separator: " ")
                }
              ]
            },
            { include_blank: "Select a prompt" },
            { class: "ck-input", id: "run_prompt_id" } %>
      <div class="ck-prompt-summary" id="prompt-summary" hidden>
        <p class="ck-prompt-summary__description" id="prompt-summary-description" hidden></p>
        <p class="ck-prompt-summary__template" id="prompt-summary-template"></p>
      </div>
    </div>

    <div class="ck-field" id="output-column-field" hidden>
      <%= form.label :output_column, "Output column", class: "ck-label" %>
      <%= form.text_field :output_column, value: run.output_column.presence || "actual_output", class: "ck-input", id: "run_output_column", placeholder: "actual_output" %>
      <p class="ck-field-hint">Name of the dataset column whose value will be graded as the response. Defaults to <code>actual_output</code>.</p>
    </div>

    <div class="ck-field" id="dataset-field">
      <%= form.label :dataset_id, "Dataset", class: "ck-label" %>
      <% if @datasets.empty? %>
        <p class="ck-meta-copy">No datasets yet. <%= link_to "Create a dataset", new_dataset_path, class: "ck-link" %> first.</p>
      <% else %>
        <%= form.select :dataset_id,
              @datasets.map { |d| [d.name, d.id, { "data-headers" => d.headers.join(",") }] },
              { include_blank: "Select a dataset" },
              { class: "ck-input", id: "run_dataset_id" } %>
      <% end %>
      <p class="ck-field-hint" id="dataset-hint"></p>
    </div>

    <div class="ck-field">
      <label class="ck-label" for="run_temperature" style="position: relative;">
        Temperature<span class="ck-info-toggle" tabindex="0">?</span><span class="ck-info-popup">Controls how random the model's output is. Lower values are more focused and deterministic — the model picks the most likely words. Higher values are more varied and creative, with more risk of odd phrasing. Most LLMs default to 1.0; for evaluation, try a few values and see how your prompt holds up. Newer reasoning models (Claude Opus 4.7, GPT-5 family, etc.) ignore temperature entirely — CompletionKit detects this and re-sends without the parameter.</span>
      </label>
      <div class="ck-slider-row">
        <%= form.range_field :temperature, min: 0, max: 1, step: 0.1, class: "ck-slider", id: "run_temperature", oninput: "document.getElementById('temp-value').textContent = this.value" %>
        <span class="ck-slider-value" id="temp-value"><%= run.temperature || 1.0 %></span>
      </div>
    </div>

    <div class="ck-field" id="judge-field">
      <label class="ck-label" for="run_judge_model" style="position: relative;">
        Judge model<span class="ck-info-toggle" tabindex="0">?</span><span class="ck-info-popup">Judge models score generated responses against your metrics. Pick one when configuring a run.</span>
      </label>
      <% available = CompletionKit::ApiConfig.available_models(scope: :judging) %>
      <% if available.any? %>
        <div class="ck-select-with-action">
          <%= form.select :judge_model, ck_grouped_models(available, run.judge_model), { include_blank: "None" }, { class: "ck-input", id: "run_judge_model" } %>
          <% ck_refreshing = CompletionKit::ProviderCredential.discovery_in_progress? %>
          <button type="button" class="ck-icon-btn<%= ' ck-icon-btn--spinning' if ck_refreshing %>" title="Refresh models" <%= 'disabled' if ck_refreshing %> onclick="ckRefreshModels()"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" width="16" height="16"><path fill-rule="evenodd" d="M13.836 2.477a.75.75 0 0 1 .75.75v3.182a.75.75 0 0 1-.75.75h-3.182a.75.75 0 0 1 0-1.5h1.37l-.84-.841a4.5 4.5 0 0 0-7.08.681.75.75 0 0 1-1.264-.808 6 6 0 0 1 9.44-.908l.84.84V3.227a.75.75 0 0 1 .75-.75Zm-.911 7.5A.75.75 0 0 1 13.199 11a6 6 0 0 1-9.44.908l-.84-.84v1.68a.75.75 0 0 1-1.5 0V9.567a.75.75 0 0 1 .75-.75h3.182a.75.75 0 0 1 0 1.5h-1.37l.84.841a4.5 4.5 0 0 0 7.08-.681.75.75 0 0 1 1.024-.274Z" clip-rule="evenodd"/></svg></button>
        </div>
        <p class="ck-field-hint" id="judge-hint"></p>
        <div hidden data-refresh-progress-carriers>
          <% CompletionKit::ProviderCredential.find_each do |pc| %>
            <%= turbo_stream_from "completion_kit_provider_#{pc.id}" %>
            <%= render "completion_kit/provider_credentials/discovery_status", provider_credential: pc, show_completed: false %>
          <% end %>
        </div>
        <p class="ck-field-hint" id="refresh-status" style="min-height: 1.2em; margin-top: -0.25rem; font-size: 0.75rem;">&nbsp;</p>
      <% else %>
        <p class="ck-field-hint" style="color: var(--ck-warning);">No judge models available.&ensp;<%= link_to "Add a provider", provider_credentials_path, class: "ck-link" %></p>
        <%= form.hidden_field :judge_model, value: nil, id: "run_judge_model" %>
      <% end %>
    </div>

    <div class="ck-field" id="metrics-field">
      <label class="ck-label">Metrics</label>
      <% if @all_metrics.empty? %>
        <p class="ck-field-hint" style="color: var(--ck-warning);">No metrics yet.&ensp;<%= link_to "Create a metric", new_metric_path, class: "ck-link" %></p>
      <% else %>
        <p class="ck-field-hint" id="metrics-hint"></p>
        <% if @metric_groups.any? %>
          <div class="ck-metric-groups">
            <span class="ck-metric-groups__label">Groups</span>
            <div class="ck-metric-groups__row">
              <% @metric_groups.each do |g| %>
                <button type="button"
                        class="ck-metric-group-pill"
                        data-metric-group
                        data-metric-ids="<%= g.metric_ids.join(",") %>"
                        onclick="ckToggleMetricGroup(this)">
                  <span class="ck-metric-group-pill__check" aria-hidden="true">✓</span>
                  <span class="ck-metric-group-pill__label"><%= g.name %></span>
                  <span class="ck-metric-group-pill__count"><%= g.metric_ids.size %></span>
                </button>
              <% end %>
            </div>
          </div>
          <div class="ck-metric-divider"><span>or pick individually</span></div>
        <% end %>

        <% available_filter_tags = @all_metrics.flat_map(&:tags).uniq.sort_by(&:name) %>
        <% if available_filter_tags.any? %>
          <div class="ck-metric-tag-filter" data-metric-tag-filter>
            <span class="ck-metric-tag-filter__label">Filter metrics by tag</span>
            <% available_filter_tags.each do |tag| %>
              <button type="button"
                      class="tag-mark tag-mark--off ck-metric-tag-filter__chip"
                      style="--mark-color: var(--tag-<%= tag.color %>);"
                      data-filter-tag="<%= tag.name %>"
                      onclick="ckToggleMetricGroupFilter(this)"><%= tag.name %></button>
            <% end %>
          </div>
        <% end %>

        <div class="ck-metric-checkboxes" data-metric-checkboxes>
          <% @all_metrics.each do |metric| %>
            <label class="ck-checkbox-label" data-metric-tags="<%= metric.tag_names.join(",") %>">
              <%= check_box_tag "run[metric_ids][]", metric.id, run.metric_ids.include?(metric.id), class: "ck-checkbox", id: "run_metric_#{metric.id}" %>
              <span class="ck-checkbox-label__box" aria-hidden="true"></span>
              <span class="ck-checkbox-label__body">
                <span class="ck-checkbox-label__text"><%= metric.name %></span>
                <% if metric.instruction.present? %>
                  <span class="ck-checkbox-label__hint"><%= truncate(metric.instruction.to_s, length: 90) %></span>
                <% end %>
                <% if metric.tags.any? %>
                  <div class="tag-marks-row">
                    <%= render "completion_kit/tags/marks", tags: metric.tags %>
                  </div>
                <% end %>
              </span>
            </label>
          <% end %>
        </div>
      <% end %>
    </div>

    <script>
function updateRunForm() {
  var promptEl = document.getElementById('run_prompt_id');
  var judgeEl = document.getElementById('run_judge_model');
  var judgeOnlyEl = document.getElementById('run_judge_only');
  var judgeOnly = !!(judgeOnlyEl && judgeOnlyEl.checked);
  var promptField = document.getElementById('prompt-field');
  var outputColumnField = document.getElementById('output-column-field');
  var outputColumnEl = document.getElementById('run_output_column');
  if (promptField) promptField.hidden = judgeOnly;
  if (outputColumnField) outputColumnField.hidden = !judgeOnly;
  if (judgeOnly && promptEl) promptEl.value = '';

  var prompt = promptEl ? promptEl.value : '';
  var judge = judgeEl ? judgeEl.value : '';
  var metrics = document.querySelectorAll('input[name="run[metric_ids][]"]:checked');
  var judgeField = document.getElementById('judge-field');
  var metricsField = document.getElementById('metrics-field');
  var judgeHint = document.getElementById('judge-hint');
  var metricsHint = document.getElementById('metrics-hint');
  var submitBtn = document.getElementById('run-submit');

  if (judgeField) judgeField.className = 'ck-field';
  if (metricsField) metricsField.className = 'ck-field';
  if (judgeHint) judgeHint.textContent = '';
  if (metricsHint) metricsHint.textContent = '';

  if (judge && metrics.length > 0) {
    if (judgeHint) judgeHint.textContent = 'Responses will be generated then judged automatically.';
  } else if (judge && metrics.length === 0) {
    if (judgeField) judgeField.className = 'ck-field ck-field--info';
    if (metricsField) metricsField.className = 'ck-field ck-field--info';
    if (metricsHint) metricsHint.textContent = 'Select at least one metric or group to enable judging.';
  } else if (!judge && metrics.length > 0) {
    if (judgeField) judgeField.className = 'ck-field ck-field--info';
    if (judgeHint) judgeHint.textContent = 'Select a judge model to enable judging.';
  }

  var datasetEl = document.getElementById('run_dataset_id');
  var datasetHint = document.getElementById('dataset-hint');
  var datasetField = document.getElementById('dataset-field');
  var dataset = datasetEl ? datasetEl.value : '';
  var selectedOption = promptEl ? promptEl.options[promptEl.selectedIndex] : null;
  var hasVars = selectedOption && selectedOption.dataset.hasVariables === '1';
  var promptVars = (selectedOption && selectedOption.dataset.variables ? selectedOption.dataset.variables.split(/,\s*/) : []).filter(Boolean);

  var missingVars = [];
  if (hasVars && dataset && datasetEl) {
    var datasetOption = datasetEl.options[datasetEl.selectedIndex];
    var headers = (datasetOption && datasetOption.dataset.headers ? datasetOption.dataset.headers.split(/,\s*/) : []).filter(Boolean);
    missingVars = promptVars.filter(function(v) { return headers.indexOf(v) === -1; });
  }

  if (datasetField) datasetField.className = 'ck-field';
  if (datasetHint) datasetHint.textContent = '';
  if (missingVars.length > 0) {
    if (datasetField) datasetField.className = 'ck-field ck-field--error';
    if (datasetHint) datasetHint.textContent = 'Dataset is missing ' + (missingVars.length === 1 ? 'column' : 'columns') + ' the prompt needs: ' + missingVars.join(', ');
  } else if (hasVars && !dataset) {
    if (datasetField) datasetField.className = 'ck-field ck-field--info';
    if (datasetHint) datasetHint.textContent = 'This prompt uses variables. Select a dataset to provide values.';
  }

  var summary = document.getElementById('prompt-summary');
  if (summary) {
    if (selectedOption && selectedOption.value) {
      var desc = selectedOption.dataset.description || '';
      var tmpl = selectedOption.dataset.templatePreview || '';
      var descEl = document.getElementById('prompt-summary-description');
      descEl.textContent = desc;
      descEl.hidden = !desc;
      document.getElementById('prompt-summary-template').textContent = tmpl;
      summary.hidden = false;
    } else {
      summary.hidden = true;
    }
  }

  var valid;
  if (judgeOnly) {
    valid = !!dataset;
    if (dataset && datasetEl && outputColumnEl) {
      var headersJudge = (datasetEl.options[datasetEl.selectedIndex] && datasetEl.options[datasetEl.selectedIndex].dataset.headers ? datasetEl.options[datasetEl.selectedIndex].dataset.headers.split(/,\s*/) : []).filter(Boolean);
      var col = (outputColumnEl.value || 'actual_output').trim();
      if (col === '' || headersJudge.indexOf(col) === -1) {
        valid = false;
        if (datasetField) datasetField.className = 'ck-field ck-field--error';
        if (datasetHint) datasetHint.textContent = "Dataset has no \"" + col + "\" column — pick a different output column or dataset.";
      }
    } else if (!dataset) {
      if (datasetField) datasetField.className = 'ck-field ck-field--info';
      if (datasetHint) datasetHint.textContent = 'Judge-only runs need a dataset that supplies the output column.';
    }
  } else {
    valid = prompt !== '';
    if (hasVars && !dataset) valid = false;
    if (missingVars.length > 0) valid = false;
  }
  if (judge && metrics.length === 0) valid = false;
  if (!judge && metrics.length > 0) valid = false;
  if (submitBtn) submitBtn.disabled = !valid;

  ckUpdateMetricGroupsState();
}

function ckToggleMetricGroup(button) {
  var ids = (button.getAttribute('data-metric-ids') || '').split(',').filter(Boolean);
  var allChecked = ids.every(function(id) {
    var cb = document.getElementById('run_metric_' + id);
    return cb && cb.checked;
  });
  ids.forEach(function(id) {
    var cb = document.getElementById('run_metric_' + id);
    if (cb) cb.checked = !allChecked;
  });
  updateRunForm();
}

function ckUpdateMetricGroupsState() {
  document.querySelectorAll('[data-metric-group]').forEach(function(btn) {
    var ids = (btn.getAttribute('data-metric-ids') || '').split(',').filter(Boolean);
    if (ids.length === 0) return;
    var allChecked = ids.every(function(id) {
      var cb = document.getElementById('run_metric_' + id);
      return cb && cb.checked;
    });
    btn.classList.toggle('ck-metric-group-pill--active', allChecked);
  });
}

var judgeEl = document.getElementById('run_judge_model');
var promptEl = document.getElementById('run_prompt_id');
var datasetEl = document.getElementById('run_dataset_id');
var judgeOnlyEl = document.getElementById('run_judge_only');
var outputColumnEl = document.getElementById('run_output_column');
if (judgeEl) judgeEl.addEventListener('change', updateRunForm);
if (promptEl) promptEl.addEventListener('change', updateRunForm);
if (datasetEl) datasetEl.addEventListener('change', updateRunForm);
if (judgeOnlyEl) judgeOnlyEl.addEventListener('change', updateRunForm);
if (outputColumnEl) outputColumnEl.addEventListener('input', updateRunForm);
document.querySelectorAll('input[name="run[metric_ids][]"]').forEach(function(cb) {
  cb.addEventListener('change', updateRunForm);
});
updateRunForm();
    </script>

    <%= render "completion_kit/tags/picker", record: run, param_namespace: :run %>

    <div class="ck-actions">
      <%= link_to "Cancel", run.persisted? ? run_path(run) : runs_path, class: ck_button_classes(:light, variant: :outline), tabindex: "0" %>
      <%= form.submit(run.persisted? ? "Save run" : "Create run", class: ck_button_classes(:dark), id: "run-submit") %>
    </div>
  </div>
<% end %>
