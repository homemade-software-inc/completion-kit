<ol class="ck-breadcrumb">
  <li><%= link_to "Runs", runs_path %></li>
  <li><%= link_to @run.name, run_path(@run) %></li>
  <li>vs <%= @other_run.name %></li>
</ol>

<section class="ck-page-header">
  <div>
    <h1 class="ck-title">Comparing runs</h1>
    <p class="ck-meta-copy"><strong>A</strong>: <%= link_to @run.name, run_path(@run), class: "ck-link" %> &middot; <strong>B</strong>: <%= link_to @other_run.name, run_path(@other_run), class: "ck-link" %> &middot; <strong>Δ</strong> = B &minus; A</p>
  </div>
  <div class="ck-actions">
    <%= link_to "Pick another", compare_run_path(@run), class: ck_button_classes(:light, variant: :outline) %>
  </div>
</section>

<% if @comparison[:rows].empty? %>
  <div class="ck-empty">
    <p>No responses to compare yet.</p>
  </div>
<% else %>
  <div class="ck-table-scroll">
  <table class="ck-results-table ck-run-compare-table">
    <thead>
      <tr>
        <th scope="col">Case</th>
        <th scope="col">Metric</th>
        <th scope="col">A → B</th>
        <th scope="col" class="ck-num">Δ</th>
        <th scope="col">Version</th>
      </tr>
    </thead>
      <% @comparison[:rows].each do |row| %>
        <% case_label = ((row[:left_response].row_index || 0) + 1).to_s %>
        <tbody class="ck-compare-group">
        <% row[:per_metric].each_with_index do |pm, idx| %>
          <tr>
            <% if idx == 0 %>
              <td rowspan="<%= row[:per_metric].size %>" class="ck-compare-case">
                <span class="ck-compare-case__num">Case <%= case_label %></span>
                <span class="ck-compare-case__runs">
                  <%= link_to "A ↗", run_response_path(@run, row[:left_response]),
                        class: "ck-link ck-compare-case__run",
                        title: "Open this case in run A (#{@run.name})" %>
                  <% if row[:right_response] %>
                    <%= link_to "B ↗", run_response_path(@other_run, row[:right_response]),
                          class: "ck-link ck-compare-case__run",
                          title: "Open this case in run B (#{@other_run.name})" %>
                  <% else %>
                    <span class="ck-compare-case__run ck-compare-case__run--absent" title="No matching response in run B">B</span>
                  <% end %>
                </span>
              </td>
            <% end %>
            <td class="ck-compare-metric" data-label="Metric" title="<%= pm[:metric_name] %>"><%= pm[:metric_name] %></td>
            <td class="ck-cmp-score" data-label="A → B">
              <span class="ck-cmp-score__pair">
                <%= render "compare_score", kind: pm[:kind], passed: pm[:left_passed], score: pm[:left_score], response: row[:left_response], run: @run, side: "A" %>
                <span class="ck-cmp-score__arrow" aria-hidden="true">→</span>
                <%= render "compare_score", kind: pm[:kind], passed: pm[:right_passed], score: pm[:right_score], response: row[:right_response], run: @other_run, side: "B" %>
              </span>
            </td>
            <td class="ck-num ck-cmp-delta" data-label="Δ">
              <% if pm[:kind] == "check" %>
                <%= ck_result_change_badge(pm[:result_change]) || content_tag(:span, "—", class: "ck-cmp-score__none") %>
              <% elsif pm[:delta] %>
                <% d = pm[:delta] %>
                <% dcls = d > 0 ? "ck-delta--positive" : d < 0 ? "ck-delta--negative" : "ck-delta--zero" %>
                <span class="ck-delta <%= dcls %>"><span class="ck-delta__arrow" aria-hidden="true"><%= d > 0 ? "▲" : d < 0 ? "▼" : "=" %></span><%= d > 0 ? "+#{d}" : d.to_s %></span>
              <% else %>
                <span class="ck-cmp-score__none">—</span>
              <% end %>
            </td>
            <td class="ck-cmp-ver" data-label="Version"><% lv = pm[:left_version_label]; rv = pm[:right_version_label] %><% if lv && rv && lv != rv %><span class="ck-cmp-ver__pair"><%= lv %><span class="ck-cmp-ver__arrow" aria-hidden="true">→</span><%= rv %></span><% elsif lv || rv %><span class="ck-cmp-ver__one"><%= lv || rv %></span><% end %></td>
          </tr>
        <% end %>
        </tbody>
      <% end %>
  </table>
  </div>
<% end %>
