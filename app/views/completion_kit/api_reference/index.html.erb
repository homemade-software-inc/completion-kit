<section class="ck-page-header">
  <div>
    <h1 class="ck-title">API</h1>
    <p class="ck-lead">REST JSON API for programmatic access. All requests require a bearer token via the Authorization header.</p>
  </div>
</section>

<div class="ck-stack">
  <div class="ck-card">
    <div class="ck-split">
      <div>
        <p class="ck-kicker">Authentication</p>
        <%= render CompletionKit.config.api_reference_authentication_partial, token: @token %>
      </div>
    </div>
  </div>
</div>

<%= render "completion_kit/api_reference/body",
      base_url: @base_url,
      token: ck_masked_token(@token),
      real_token: @token,
      published_prompts: @published_prompts,
      recent_runs: @recent_runs,
      datasets: @datasets,
      metrics: @metrics,
      metric_groups: @metric_groups,
      tags: @tags,
      provider_credentials: @provider_credentials %>
