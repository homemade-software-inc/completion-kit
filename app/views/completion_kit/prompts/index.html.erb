<section class="ck-page-header">
  <div>
    <h1 class="ck-title">Prompts</h1>
    <p class="ck-lead">Prompts sent to LLMs for completion. Each prompt is versioned so you can track changes and compare results over time.</p>
  </div>
  <div class="ck-actions">
    <%= link_to "New prompt", new_prompt_path, class: ck_button_classes(:dark) %>
  </div>
</section>

<%= render "completion_kit/tags/filter_bar",
      available: @available_tags,
      selected: @selected_tags,
      base_path: prompts_path %>

<% if @prompts.any? %>
  <table class="ck-results-table ck-prompts-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Version</th>
        <th>Model</th>
        <th>Best score</th>
        <th>Runs</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @prompts.each do |prompt| %>
        <tr onclick="window.location='<%= prompt_path(prompt) %>'" style="cursor: pointer;">
          <td>
            <strong><%= prompt.name %></strong>
            <% if prompt.description.present? %>
              <p class="ck-prompts-table__desc"><%= truncate(prompt.description, length: 120) %></p>
            <% end %>
            <div class="ck-endpoint ck-endpoint--compact" onclick="event.stopPropagation()">
              <code class="ck-endpoint__url" id="prompt_endpoint_<%= prompt.id %>"><%= api_v1_prompt_path(prompt.slug) %></code>
              <button type="button" class="ck-icon-btn" title="Copy API path" onclick="event.stopPropagation();navigator.clipboard.writeText(document.getElementById('prompt_endpoint_<%= prompt.id %>').textContent)"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" width="13" height="13" aria-hidden="true"><path d="M0 6.75C0 5.784.784 5 1.75 5h1.5a.75.75 0 0 1 0 1.5h-1.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 9.25 16h-7.5A1.75 1.75 0 0 1 0 14.25Z"/><path d="M5 1.75C5 .784 5.784 0 6.75 0h7.5C15.216 0 16 .784 16 1.75v7.5A1.75 1.75 0 0 1 14.25 11h-7.5A1.75 1.75 0 0 1 5 9.25Zm1.75-.25a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25Z"/></svg></button>
            </div>
            <% if prompt.tags.any? %>
              <div class="tag-marks-row">
                <%= render "completion_kit/tags/marks", tags: prompt.tags %>
              </div>
            <% end %>
          </td>
          <% latest_version = prompt.family_versions.maximum(:version_number) %>
          <td>
            <span class="ck-chip ck-chip--soft"><%= prompt.version_label %></span>
            <% if prompt.version_number < latest_version %>
              <span class="ck-meta-copy" style="margin-left: 0.4rem;">of <%= latest_version %></span>
            <% end %>
          </td>
          <td><span class="ck-chip"><%= prompt.llm_model %></span></td>
          <% family_runs = CompletionKit::Run.where(prompt_id: prompt.family_versions.select(:id)) %>
          <% current_version_runs = prompt.runs.includes(responses: :reviews) %>
          <% best_score = current_version_runs.map(&:avg_score).compact.max %>
          <td>
            <% if best_score %>
              <span class="<%= ck_badge_classes(ck_score_kind(best_score)) %>"><%= best_score %></span>
            <% else %>
              <span class="ck-prompts-table__dim">—</span>
            <% end %>
          </td>
          <td>
            <div class="ck-prompts-table__runs">
              <span class="ck-prompts-table__runs-count"><%= family_runs.count %></span>
              <% last_run = family_runs.order(created_at: :desc).first %>
              <% if last_run %>
                <span class="ck-prompts-table__runs-when">last <time data-relative-time datetime="<%= last_run.created_at.utc.iso8601 %>"><%= time_ago_in_words(last_run.created_at) %> ago</time></span>
              <% else %>
                <span class="ck-prompts-table__runs-when">never run</span>
              <% end %>
            </div>
          </td>
          <td class="ck-results-table__arrow">&rarr;</td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% elsif @selected_tags.any? %>
  <div class="ck-empty">
    <p>No prompts match these tags. <%= link_to "Clear filters", prompts_path, class: "ck-link" %>.</p>
  </div>
<% else %>
  <div class="ck-empty">
    No prompts yet. Create one to get started.
  </div>
<% end %>
