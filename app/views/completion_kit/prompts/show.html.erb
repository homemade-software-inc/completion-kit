<ol class="ck-breadcrumb">
  <li><%= link_to "Prompts", prompts_path %></li>
  <li><%= @prompt.name %></li>
</ol>

<section class="ck-page-header">
  <div>
    <div class="ck-inline">
      <h1 class="ck-title"><%= @prompt.name %></h1>
      <span class="ck-chip ck-chip--soft"><%= @prompt.version_label %></span>
      <span class="ck-chip"><%= @prompt.llm_model %></span>
    </div>
    <% if @prompt.description.present? %>
      <p class="ck-meta-copy"><%= @prompt.description %></p>
    <% end %>
    <div class="ck-endpoint">
      <code class="ck-endpoint__url" id="prompt_endpoint"><%= request.base_url %><%= api_v1_prompt_path(@prompt.slug) %></code>
      <button type="button" class="ck-icon-btn" title="Copy endpoint" onclick="navigator.clipboard.writeText(document.getElementById('prompt_endpoint').textContent)"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" width="14" height="14"><path d="M0 6.75C0 5.784.784 5 1.75 5h1.5a.75.75 0 0 1 0 1.5h-1.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 9.25 16h-7.5A1.75 1.75 0 0 1 0 14.25Z"/><path d="M5 1.75C5 .784 5.784 0 6.75 0h7.5C15.216 0 16 .784 16 1.75v7.5A1.75 1.75 0 0 1 14.25 11h-7.5A1.75 1.75 0 0 1 5 9.25Zm1.75-.25a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25Z"/></svg></button>
    </div>
  </div>

  <div class="ck-actions">
    <% current = @prompt.family_versions.find_by(current: true) || @prompt %>
    <%= link_to "Edit", edit_prompt_path(current), class: ck_button_classes(:light, variant: :outline) %>
    <%= link_to "Run test", new_run_path(prompt_id: current.id), class: ck_button_classes(:dark) %>
  </div>
</section>

<% if @prompt.tags.any? %>
  <div class="tag-marks-row tag-marks-row--header">
    <%= render "completion_kit/tags/marks", tags: @prompt.tags %>
  </div>
<% end %>

<section>
  <div class="ck-prompt-preview__header">
    <p class="ck-kicker">Prompt</p>
    <% judged_run = @runs.select { |r| r.prompt_id == @prompt.id && r.status == "completed" }.find { |r| r.responses.joins(:reviews).exists? } %>
    <% if judged_run %>
      <%= button_to suggest_run_path(judged_run), method: :post, class: ck_button_classes(:light, variant: :outline) + " ck-button--sm", form_class: "inline-block" do %>
        <%= heroicon_tag "sparkles", variant: :outline, class: "ck-magic-icon", "aria-hidden": "true" %>
        Suggest improvements
      <% end %>
    <% else %>
      <p class="ck-hint"><%= link_to "Run a test with judging configured", new_run_path(prompt_id: @prompt.id), class: "ck-link" %> to get AI-suggested improvements.</p>
    <% end %>
  </div>
  <pre class="ck-code ck-code--dark"><%= @prompt.template %></pre>
</section>

<% versions = @prompt.family_versions.includes(runs: { responses: :reviews }).to_a %>
<% predecessor_of = versions.index_with { |v| versions.detect { |o| o.version_number < v.version_number } } %>
<% version_changed = ->(v, pred) { pred && (pred.template != v.template || pred.llm_model != v.llm_model) } %>
<% if versions.size > 1 %>
  <section class="ck-card--spaced">
    <p class="ck-kicker">Versions</p>
    <table class="ck-results-table" style="margin-top: 0.5rem;">
      <thead>
        <tr>
          <th>Version</th>
          <th>Model</th>
          <th>Best score</th>
          <th>Created</th>
        </tr>
      </thead>
      <tbody>
        <% versions.each do |v| %>
          <% best_score = v.runs.map(&:avg_score).compact.max %>
          <% pred = predecessor_of[v] %>
          <tr class="<%= "ck-results-table__row--active" if v.id == @prompt.id %>" onclick="window.location='<%= prompt_path(v) %>'" style="cursor: pointer;">
            <td>
              <div class="ck-version-cell">
                <div class="ck-version-cell__label" onclick="event.stopPropagation()">
                  <strong>v<%= v.version_number %></strong>
                  <% if v.current? %>
                    <span class="ck-chip">Published</span>
                  <% else %>
                    <%= button_to "Publish", publish_prompt_path(v), method: :post, class: "ck-chip ck-chip--publish", form_class: "inline-block" %>
                  <% end %>
                </div>
                <% if version_changed.call(v, pred) %>
                  <button type="button" class="ck-cell-link ck-cell-link--delta" title="What changed from v<%= pred.version_number %>" onclick="event.stopPropagation();document.getElementById('ck-vdiff-<%= v.id %>').showModal()">&Delta;</button>
                <% end %>
              </div>
            </td>
            <td><span class="ck-chip ck-chip--soft"><%= v.llm_model %></span></td>
            <td>
              <% if best_score %>
                <span class="<%= ck_badge_classes(ck_score_kind(best_score)) %>"><%= best_score %></span>
              <% else %>
                <span class="ck-prompts-table__dim">—</span>
              <% end %>
            </td>
            <td class="ck-meta-copy"><time datetime="<%= v.created_at.iso8601 %>" data-local-time><%= v.created_at.utc.strftime("%b %-d, %Y at %-I:%M %p UTC") %></time></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>

  <% versions.each do |v| %>
    <% pred = predecessor_of[v] %>
    <% next unless version_changed.call(v, pred) %>
    <dialog id="ck-vdiff-<%= v.id %>" class="ck-modal" onclick="if(event.target===this)this.close()">
      <article class="ck-modal__panel" tabindex="-1" autofocus onclick="event.stopPropagation()">
        <header class="ck-modal__header">
          <div class="ck-modal__heading">
            <h2 class="ck-modal__title">v<%= pred.version_number %> &rarr; v<%= v.version_number %></h2>
            <span class="ck-modal__meta">What changed in <%= v.version_label %><% if v.current? %> (published)<% end %></span>
          </div>
          <button type="button" class="ck-modal__close" aria-label="Close" onclick="this.closest('dialog').close()">&times;</button>
        </header>
        <div class="ck-modal__body">
          <% if pred.llm_model != v.llm_model %>
            <p class="ck-version-change">
              <span class="ck-version-change__label">Model</span>
              <span class="ck-version-change__old"><%= pred.llm_model %></span>
              <span class="ck-version-change__arrow" aria-hidden="true">&rarr;</span>
              <span class="ck-version-change__new"><%= v.llm_model %></span>
            </p>
          <% end %>
          <% if pred.template != v.template %>
            <div class="ck-suggest-diff">
              <div class="ck-suggest-diff__pane">
                <div class="ck-suggest-diff__header"><span class="ck-suggest-diff__label ck-suggest-diff__label--before"><%= pred.version_label %></span></div>
                <pre class="ck-suggest-diff__code"><%= ck_word_diff_old(pred.template, v.template) %></pre>
              </div>
              <div class="ck-suggest-diff__pane">
                <div class="ck-suggest-diff__header"><span class="ck-suggest-diff__label ck-suggest-diff__label--after"><%= v.version_label %></span></div>
                <pre class="ck-suggest-diff__code"><%= ck_word_diff_new(pred.template, v.template) %></pre>
              </div>
            </div>
          <% end %>
        </div>
      </article>
    </dialog>
  <% end %>
<% end %>

<% if @runs.any? %>
  <section class="ck-card--spaced">
    <p class="ck-kicker">Runs</p>

    <table class="ck-results-table ck-runs-table" style="margin-top: 0.5rem;">
      <thead>
        <tr>
          <th>Run</th>
          <th>Responses</th>
          <th>Metrics</th>
          <th>Avg score</th>
          <th>When</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @runs.each do |run| %>
          <%= render "completion_kit/runs/row", run: run %>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>

<% suggestions = CompletionKit::Suggestion.where(prompt_id: @prompt.family_versions.select(:id)).order(created_at: :desc) %>
<% if suggestions.any? %>
  <section class="ck-card--spaced">
    <p class="ck-kicker">Suggestions</p>
    <table class="ck-results-table" style="margin-top: 0.5rem;">
      <thead>
        <tr>
          <th>Run</th>
          <th>Reasoning</th>
          <th>Applied</th>
          <th>When</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% suggestions.each do |s| %>
          <tr onclick="window.location='<%= suggestion_path(s, from: "prompt") %>'" style="cursor: pointer;">
            <td><strong><%= s.run.name %></strong></td>
            <td class="ck-meta-copy"><%= truncate(s.reasoning.to_s, length: 100) %></td>
            <td><%= s.applied_at? ? content_tag(:span, "Applied", class: "ck-chip", style: "background: var(--ck-success-soft); color: var(--ck-success);") : "&mdash;".html_safe %></td>
            <td class="ck-meta-copy"><time data-relative-time datetime="<%= s.created_at.utc.iso8601 %>"><%= time_ago_in_words(s.created_at) %></time> ago</td>
            <td class="ck-results-table__arrow">&rarr;</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>

