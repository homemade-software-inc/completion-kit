<% pill = content_tag(:span, content_tag(:span, @tag.name, id: "tag-pill-text", data: { placeholder: @tag.name }),
       id: "tag-breadcrumb-pill", class: tag_pill_class(@tag)) %>

<%= render "completion_kit/shared/settings_nav",
      section_label: "Tags",
      section_link: tags_path,
      trail: pill %>

<section class="ck-page-header">
  <div>
    <h1 class="ck-title">Edit tag</h1>
  </div>
</section>

<%= render "form", tag: @tag %>
