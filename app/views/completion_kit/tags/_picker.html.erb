<div class="ck-field">
  <p class="ck-section-title">Tags</p>
  <p class="ck-hint">Pick existing tags or type a new one. Tags help you filter and group <%= param_namespace.to_s.pluralize %>.</p>

  <% all_tags = CompletionKit::Tag.order(:name) %>
  <% selected_ids = record.persisted? ? record.tags.pluck(:id) : [] %>

  <div class="ck-tag-picker">
    <% all_tags.each do |tag| %>
      <% checked = selected_ids.include?(tag.id) %>
      <label class="<%= tag_pill_class(tag, outline: !checked) %>">
        <%= check_box_tag "#{param_namespace}[tag_names][]", tag.name, checked, hidden: true %>
        <%= tag.name %>
      </label>
    <% end %>
    <%= text_field_tag "#{param_namespace}[tag_names][]", "",
          id: "#{param_namespace}_new_tag",
          class: "ck-tag-picker__input",
          placeholder: all_tags.any? ? "+ add tag…" : "+ type your first tag",
          autocomplete: "off" %>
  </div>
</div>
