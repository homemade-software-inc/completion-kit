<%= form_with(model: tag, local: true) do |form| %>
  <% if tag.errors.any? %>
    <div class="ck-flash ck-flash--alert">
      <p class="ck-flash__title"><%= pluralize(tag.errors.count, "problem") %> prevented this tag from being saved.</p>
      <ul class="ck-error-list">
        <% tag.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="ck-card ck-form-card">
    <div class="ck-field">
      <%= form.label :name, "Tag name", class: "ck-label" %>
      <%= form.text_field :name, class: "ck-input", placeholder: "e.g. production" %>
      <% unless tag.persisted? %>
        <p class="ck-hint">Color is auto-assigned from a 10-color palette.</p>
      <% end %>
    </div>

    <div class="ck-actions ck-actions--split">
      <% if tag.persisted? %>
        <%= button_to "Delete tag", tag_path(tag), method: :delete,
              form: { data: { turbo_confirm: "Delete \"#{tag.name}\"? This removes the tag from every linked metric, prompt, run, and dataset." } },
              class: ck_button_classes(:red, variant: :outline) %>
      <% else %>
        <span></span>
      <% end %>
      <div class="ck-actions">
        <%= link_to "Cancel", tags_path, class: ck_button_classes(:light, variant: :outline) %>
        <%= form.submit(tag.persisted? ? "Save tag" : "Create tag", class: ck_button_classes(:dark)) %>
      </div>
    </div>
  </div>
<% end %>
