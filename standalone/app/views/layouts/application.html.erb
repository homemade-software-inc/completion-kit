<!DOCTYPE html>
<html>
<head>
  <title>CompletionKit</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= favicon_link_tag "completion_kit/favicon.ico" %>
  <%= stylesheet_link_tag "completion_kit/application", media: "all" %>
  <%= javascript_include_tag "turbo", type: "module" %>
  <%= javascript_include_tag "completion_kit/application", defer: true %>
</head>
<body class="ck-app">
  <header class="ck-topbar">
    <div class="ck-wrap ck-topbar__inner">
      <%= link_to root_path, class: "ck-brand" do %><%= image_tag "completion_kit/logo.png", alt: "CompletionKit", style: "height: 64px; width: auto;" %><span class="ck-brand__name">Completion<span class="ck-brand__kit">Kit</span></span><% end %>

      <details class="ck-nav-menu">
        <summary class="ck-nav-menu__trigger" aria-label="Menu">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </summary>
        <nav class="ck-nav">
          <%= link_to "Prompts", completion_kit.prompts_path, class: ck_button_classes(:light, variant: :outline) %>
          <%= link_to "Metrics", completion_kit.metrics_path, class: ck_button_classes(:light, variant: :outline) %>
          <%= link_to "Datasets", completion_kit.datasets_path, class: ck_button_classes(:light, variant: :outline) %>
          <%= link_to "Runs", completion_kit.runs_path, class: ck_button_classes(:light, variant: :outline) %>
          <details class="ck-settings-menu">
            <summary class="<%= ck_button_classes(:light, variant: :outline) %> ck-settings-menu__trigger" aria-label="Settings">
              <%= heroicon_tag "cog-6-tooth", variant: :outline, size: 18, "aria-hidden": "true" %>
            </summary>
            <div class="ck-settings-menu__panel" role="menu">
              <%= link_to "Getting started", completion_kit.onboarding_path(reset: 1), class: "ck-settings-menu__item" %>
              <%= link_to "API", completion_kit.api_reference_path, class: "ck-settings-menu__item" %>
              <%= link_to "Providers", completion_kit.provider_credentials_path, class: "ck-settings-menu__item" %>
              <%= link_to "Tags", completion_kit.tags_path, class: "ck-settings-menu__item" %>
              <%= button_to "Log out", logout_path, method: :delete, class: "ck-settings-menu__item" %>
            </div>
          </details>
        </nav>
      </details>
    </div>
  </header>

  <main class="ck-main">
    <div class="ck-wrap">
      <% flash.each do |type, message| %>
        <div class="ck-flash <%= type.to_s == "notice" ? "ck-flash--notice" : "ck-flash--alert" %>">
          <%= message %>
        </div>
      <% end %>

      <%= yield %>
    </div>
  </main>
</body>
</html>
